# Pilot region for Aret map tiles — ADR-0014
# (https://github.com/aret-app/aret-docs/blob/main/docs/adr/0014-first-map-region.md)
#
# The app's two pilot areas (aret-ios: ARET-iOS/Routes/ARETDiscoveryRegion.swift):
#   Alpi Apuane               lon 9.92–10.58, lat 43.84–44.37
#   Appennino tosco-emiliano  lon 9.34–11.33, lat 43.90–44.75
# BBOX is their union plus a 0.05° margin, as west,south,east,north.
# Keep it in sync with the app if the pilot areas change.

BBOX="9.29,43.79,11.38,44.80"

# Geofabrik extract Planetiler downloads (--area). Italy covers Liguria, Toscana
# and Emilia-Romagna in one file; Planetiler keeps only what is inside BBOX.
OSM_AREA="italy"
# The same extract as a direct link, for the weekly GitHub Actions build, which downloads it
# itself (with retries and an MD5 check) before running Planetiler.
OSM_DOWNLOAD_URL="https://download.geofabrik.de/europe/italy-latest.osm.pbf"
# Fallback when Geofabrik is unreachable: the same daily extract from OpenStreetMap France.
OSM_FALLBACK_URL="https://download.openstreetmap.fr/extracts/europe/italy-latest.osm.pbf"

# Highest zoom level we build. MapLibre "overzooms" z14 tiles for closer views.
# z14 keeps the pilot region at roughly 7,000 tiles; z15 would add ~21,000 more
# and exceed Cloudflare Pages' 20,000-file limit (ADR-0005).
MAXZOOM=14

# Small area for trying the route pipeline quickly (scripts/build-routes.sh test): around Pania
# della Croce in the Alpi Apuane, about 30 routes.
TEST_BBOX="10.30,44.01,10.36,44.05"
