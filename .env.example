# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git-ignored: it stays on your computer. Never commit it.

# Cloudflare Pages project created with: npx wrangler pages project create aret-tiles --production-branch=main
CF_PAGES_PROJECT=aret-tiles

# Optional on your own computer (Wrangler uses your `wrangler login` account).
# Needed if your login has access to several Cloudflare accounts, and in CI.
# Find it with: npx wrangler whoami
CLOUDFLARE_ACCOUNT_ID=
